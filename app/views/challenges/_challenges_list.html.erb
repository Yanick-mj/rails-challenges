<% challenges.each do |challenge| %>
  <div class="card mb-4 challenge-item">
    <div class="card-body">
      <h5 class="card-title"><%= challenge.name %></h5>
      <p class="card-text"><%= challenge.description %></p>
      <p class="card-text">
        <span class="me-4">
          <i class="fas fa-calendar-plus text-success me-1"></i>
          Start Date: <%= challenge.start_date&.strftime("%d/%m/%Y") %>
        </span>
        <span>
          <i class="fas fa-calendar-check text-danger me-1"></i>
          End Date: <%= challenge.end_date&.strftime("%d/%m/%Y") %>
        </span>
      </p>
      <%= link_to challenge, class: "btn btn-secondary" do %>
        <i class="fas fa-eye me-1"></i> Read more
      <% end %>
    </div>
  </div>
<% end %>
