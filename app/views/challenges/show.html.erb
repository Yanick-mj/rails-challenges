<div class="container-md py-5">
  <div class="row justify-content-center">
    <div class="col-lg-8 col-md-10">
      <div class="card shadow-sm p-3 mb-5 rounded">
        <!-- Bouton d'action -->
        <div class="d-flex mb-2">
          <div class="back-button">
            <%= action_button :back, challenges_path, "Challenges" %>
          </div>
          <div class="edit-button flex-grow-1 text-end">
            <% if policy(@challenge).update? %>
              <%= action_button :edit, edit_challenge_path(@challenge) %>
            <% end %>
          </div>
        </div>

        <!-- Header de la carte -->
        <div class="card-header bg-primary text-white py-4">
          <div class="d-flex justify-content-between align-items-center">
            <h1 class="card-title mb-0 h2">
              <i class="fas fa-trophy me-3"></i>
              <%= @challenge.name %>
            </h1>
            <div class="badge bg-light text-primary fs-6 px-3 py-2">
              <i class="fas fa-info-circle me-1"></i>Status
            </div>
          </div>
        </div>

        <!-- Corps de la carte -->
        <div class="card-body p-5">
          <!-- Description -->
          <div class="mb-4">
            <h5 class="text-muted mb-3">
              <i class="fas fa-info-circle me-2"></i>
              Description
            </h5>
            <p class="card-text fs-5 lh-base text-dark">
              <%= @challenge.description %>
            </p>
          </div>

          <!-- Dates -->
          <div class="row g-4">
            <div class="col-md-6">
              <div class="d-flex align-items-center p-3 bg-light rounded">
                <div class="me-3">
                  <i class="fas fa-calendar-plus text-success fs-4"></i>
                </div>
                <div>
                  <small class="text-muted d-block">Date de début</small>
                  <strong class="fs-6"><%= @challenge.start_date.strftime("%d/%m/%Y") %></strong>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="d-flex align-items-center p-3 bg-light rounded">
                <div class="me-3">
                  <i class="fas fa-calendar-check text-danger fs-4"></i>
                </div>
                <div>
                  <small class="text-muted d-block">Date de fin</small>
                  <strong class="fs-6"><%= @challenge.end_date.strftime("%d/%m/%Y") %></strong>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
