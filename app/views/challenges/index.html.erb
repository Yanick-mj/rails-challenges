
<div class="container mt-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2><%= @page_title %></h2>
    <div class="create-button">
      <%= link_to new_challenge_path, class: "btn btn-primary" do %>
        <i class="fas fa-plus me-2"></i> Challenge
      <% end %>
    </div>
  </div>

  <!-- Options de tri simples -->
  <div class="mb-3">
    <div class="btn-group" role="group">
      <%= link_to challenges_path(sort: 'asc'), class: "btn btn-outline-secondary #{params[:sort] != 'desc' ? 'active' : ''}" do %>
        <i class="fas fa-sort-amount-up me-1"></i> Ancien
      <% end %>
      <%= link_to challenges_path(sort: 'desc'), class: "btn btn-outline-secondary #{params[:sort] == 'desc' ? 'active' : ''}" do %>
        <i class="fas fa-sort-amount-down me-1"></i> Récent
      <% end %>
    </div>
  </div>

  <!-- Liste des challenges -->
  <% if @challenges.empty? %>
    <p>No challenges available at the moment.</p>
  <% else %>
    <% @challenges.each do |challenge| %>
      <div class="card mb-4">
        <div class="card-body">
          <h5 class="card-title"><%= challenge.name %></h5>
          <p class="card-text"><%= truncate(challenge.description, length: 100) %></p>
          <p class="card-text">
            <span class="me-4">
              <i class="fas fa-calendar-plus text-success me-1"></i>
              Start Date: <%= challenge.start_date&.strftime("%d/%m/%Y") %>
            </span>
            <span>
              <i class="fas fa-calendar-check text-danger me-1"></i>
              End Date: <%= challenge.end_date&.strftime("%d/%m/%Y") %>
            </span>
          </p>
          <%= link_to challenge, class: "btn btn-secondary" do %>
            <i class="fas fa-eye me-1"></i> Read more
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
