<%# ======================================== %>
<%# FORMULAIRE PARTIEL POUR LES CHALLENGES %>
<%# ======================================== %>
<%# Ce formulaire est utilisé pour créer et modifier des challenges %>
<%# Il s'adapte automatiquement selon le contexte (nouveau ou édition) %>

<%= form_with(model: @challenge, local: true) do |form| %>

  <%# ======================================== %>
  <%# AFFICHAGE DES ERREURS DE VALIDATION %>
  <%# ======================================== %>
  <% if @challenge.errors.any? %>
    <div class="alert alert-danger">
      <h4><%= pluralize(@challenge.errors.count, "erreur") %> :</h4>
      <ul>
        <% @challenge.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# ======================================== %>
  <%# CHAMP NOM DU CHALLENGE %>
  <%# ======================================== %>
  <div class="mb-3">
    <%= form.label :name, "Nom du challenge", class: "form-label" %>
    <%= form.text_field :name, class: "form-control", placeholder: "Entrez le nom du challenge" %>
  </div>

  <%# ======================================== %>
  <%# CHAMP DESCRIPTION DU CHALLENGE %>
  <%# ======================================== %>
  <div class="mb-3">
    <%= form.label :description, "Description", class: "form-label" %>
    <%= form.text_area :description, class: "form-control", rows: 4, placeholder: "Décrivez le challenge" %>
  </div>

  <%# ======================================== %>
  <%# CHAMPS DE DATES (DÉBUT ET FIN) %>
  <%# ======================================== %>
  <div class="row">
    <%# Date de début du challenge %>
    <div class="col-md-6">
      <div class="mb-3">
        <%= form.label :start_date, "Date de début", class: "form-label" %>
        <%= form.date_field :start_date,
                           class: "form-control",
                           min: Date.current.to_s,
                           value: @challenge.start_date&.to_s || Date.current.to_s %>
        <div class="form-text">
          <i class="fas fa-info-circle me-1"></i>
          La date de début ne peut pas être dans le passé
        </div>
      </div>
    </div>
    <%# Date de fin du challenge %>
    <div class="col-md-6">
      <div class="mb-3">
        <%= form.label :end_date, "Date de fin", class: "form-label" %>
        <%= form.date_field :end_date,
                           class: "form-control",
                           min: @challenge.start_date&.to_s || Date.current.to_s %>
        <div class="form-text">
          <i class="fas fa-info-circle me-1"></i>
          La date de fin doit être après la date de début
        </div>
      </div>
    </div>
  </div>

  <%# ======================================== %>
  <%# CHAMP NOMBRE MAXIMUM DE PARTICIPANTS %>
  <%# ======================================== %>
  <div class="mb-3">
    <%= form.label :max_participants, "Nombre maximum de participants", class: "form-label" %>
    <%= form.number_field :max_participants,
                         class: "form-control",
                         min: 1,
                         max: 100,
                         placeholder: "Entrez le nombre maximum de participants" %>
    <% if @challenge.persisted? %>
      <div class="form-text">
        <i class="fas fa-info-circle me-1"></i>
        Actuellement <%= @challenge.participants.count %> participant(s).
        Vous ne pouvez pas réduire en dessous de ce nombre.
      </div>
    <% end %>
  </div>

  <%# ======================================== %>
  <%# BOUTONS D'ACTION DU FORMULAIRE %>
  <%# ======================================== %>
  <div class="d-flex gap-3">
    <%# Bouton Annuler - Retour à la liste des challenges %>
    <%= action_button :cancel, challenges_path, "Annuler" %>

    <%# Bouton de soumission - Texte et icône adaptatifs %>
    <%# Si nouveau challenge : "Créer le challenge" avec icône plus %>
    <%# Si édition : "Mettre à jour" avec icône save %>
    <%= cta_submit @challenge.new_record? ? "Créer le challenge" : "Mettre à jour",
                   variant: :primary,
                   icon: @challenge.new_record? ? "plus" : "save" %>
  </div>
<% end %>

<%# ======================================== %>
<%# FIN DU FORMULAIRE PARTIEL %>
<%# ======================================== %>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const startDateField = document.querySelector('input[name="challenge[start_date]"]');
  const endDateField = document.querySelector('input[name="challenge[end_date]"]');

  if (startDateField && endDateField) {
    // Mettre à jour la date de fin minimale quand la date de début change
    startDateField.addEventListener('change', function() {
      const startDate = this.value;
      if (startDate) {
        endDateField.min = startDate;
        // Si la date de fin actuelle est avant la nouvelle date de début, la réinitialiser
        if (endDateField.value && endDateField.value < startDate) {
          endDateField.value = startDate;
        }
      }
    });
  }
});
</script>
