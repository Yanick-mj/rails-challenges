<%= render "devise/shared/auth_layout",
    icon_name: 'user-plus',
    title: 'Inscription',
    subtitle: 'Créez votre compte Rails Challenge',
    form_url: registration_path(resource_name),
    show_errors: true,
    password_autocomplete: "new-password",
    password_placeholder: "Mot de passe",
    show_password_hint: @minimum_password_length.present?,
    show_password_confirmation: true,
    show_remember_me: false,
    submit_text: "S'inscrire" %>
