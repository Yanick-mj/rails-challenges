<%= render "devise/shared/auth_layout",
    icon_name: 'sign-in-alt',
    title: 'Connexion',
    subtitle: 'Connectez-vous à votre compte Rails Challenge',
    form_url: session_path(resource_name),
    show_errors: false,
    password_autocomplete: "current-password",
    password_placeholder: "Votre mot de passe",
    show_password_hint: false,
    show_password_confirmation: false,
    show_remember_me: devise_mapping.rememberable?,
    submit_text: "Se connecter" %>
