<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
  <div class="container">
    <%= link_to root_path, class: "navbar-brand" do %>
      <%= icon('trophy', 'me-2') %>Rails Challenge
    <% end %>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto">
        <% if user_signed_in? %>
          <!-- Desktop: Dropdown -->
          <li class="nav-item dropdown d-none d-lg-block">
            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
              <%= icon('user') %><%= user_display_name(current_user) %>
            </a>
            <ul class="dropdown-menu">
              <li><%= link_to "Profile", edit_user_registration_path, class: "dropdown-item" %></li>
              <li><%= link_to "Mes Challenges", challenges_path(owner: "me"), class: "dropdown-item" %></li>
              <li><hr class="dropdown-divider"></li>
              <li><%= button_to "Log out", destroy_user_session_path, method: :delete, class: "dropdown-item" %></li>
            </ul>
          </li>

          <!-- Mobile: Options dans le menu hamburger -->
          <li class="nav-item d-lg-none">
            <%= link_to edit_user_registration_path, class: "nav-link" do %>
              <%= icon('user-edit') %>Profile
            <% end %>
          </li>
          <li class="nav-item d-lg-none">
            <%= link_to challenges_path(owner: "me"), class: "nav-link" do %>
              <%= icon('list') %>Mes Challenges
            <% end %>
          </li>
          <li class="nav-item d-lg-none">
            <%= button_to destroy_user_session_path, method: :delete, class: "nav-link mobile-logout-btn" do %>
              <%= icon('sign-out-alt') %>Log out
            <% end %>
          </li>
        <% else %>
          <li class="nav-item me-2">
            <%= action_button :login, new_user_session_path, "Log in", variant: :light %>
          </li>
          <li class="nav-item">
            <%= action_button :signup, new_user_registration_path, "Sign up" %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</nav>
