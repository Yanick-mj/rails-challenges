#!/usr/bin/env bash

echo "🔍 Vérification post-déploiement Heroku..."
echo ""

# 1. Vérifier que l'application répond
echo "🌐 Test de l'application..."
if curl -f -s https://$HEROKU_APP_NAME.herokuapp.com/up > /dev/null; then
  echo "✅ Application: OK"
else
  echo "❌ Application: ÉCHEC"
  exit 1
fi

echo ""

# 2. Vérifier les dynos
echo "🚀 Vérification des dynos..."
if heroku ps --app $HEROKU_APP_NAME | grep -q "web.1.*up"; then
  echo "✅ Dyno web: OK"
else
  echo "❌ Dyno web: ÉCHEC"
  exit 1
fi

if heroku ps --app $HEROKU_APP_NAME | grep -q "worker.1.*up"; then
  echo "✅ Dyno worker: OK"
else
  echo "❌ Dyno worker: ÉCHEC"
  exit 1
fi

echo ""

# 3. Vérifier les variables d'environnement
echo "🔧 Vérification des variables d'environnement..."
if heroku config:get SMTP_USERNAME --app $HEROKU_APP_NAME | grep -q .; then
  echo "✅ SMTP_USERNAME: OK"
else
  echo "❌ SMTP_USERNAME: MANQUANT"
  exit 1
fi

if heroku config:get SMTP_PASSWORD --app $HEROKU_APP_NAME | grep -q .; then
  echo "✅ SMTP_PASSWORD: OK"
else
  echo "❌ SMTP_PASSWORD: MANQUANT"
  exit 1
fi

if heroku config:get APP_HOST --app $HEROKU_APP_NAME | grep -q .; then
  echo "✅ APP_HOST: OK"
else
  echo "❌ APP_HOST: MANQUANT"
  exit 1
fi

echo ""

# 4. Vérifier les logs pour les erreurs
echo "📋 Vérification des logs..."
if heroku logs --tail --app $HEROKU_APP_NAME --num 50 | grep -q "error\|Error\|ERROR"; then
  echo "⚠️  Erreurs détectées dans les logs"
  echo "Consultez: heroku logs --tail --app $HEROKU_APP_NAME"
else
  echo "✅ Logs: OK"
fi

echo ""
echo "🎉 Vérification post-déploiement terminée !"
echo ""
echo "📋 Commandes utiles:"
echo "   heroku logs --tail --app $HEROKU_APP_NAME"
echo "   heroku run rails console --app $HEROKU_APP_NAME"
echo "   heroku run rails db:migrate --app $HEROKU_APP_NAME"
echo "   heroku run rails db:seed --app $HEROKU_APP_NAME"
